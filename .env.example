# Azure Cosmos DB Configuration
COSMOS_DB_ENDPOINT=https://<your-account-name>.documents.azure.com:443/
COSMOS_DB_NAME=<your-database-name>
COSMOS_DB_CONTAINER=container-checkpoints

# Authentication:
# For Managed Identity (recommended), leave COSMOS_DB_KEY blank.
# For Account Key, provide the primary or secondary key below.
COSMOS_DB_KEY=
